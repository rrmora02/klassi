# Credenciales para las pruebas E2E (copiar a .env.e2e — NO se commitea).
# SOLO usuarios de prueba de la instancia de DESARROLLO de Clerk.

# Llaves de Clerk (las mismas de tu .env de desarrollo)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Staff: ADMIN o RECEPTIONIST de una escuela de prueba
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=

# Tutor: con un alumno vinculado y SIN membresía de escuela
E2E_PARENT_EMAIL=
E2E_PARENT_PASSWORD=

# Instructor: rol INSTRUCTOR con al menos un grupo asignado
E2E_INSTRUCTOR_EMAIL=
E2E_INSTRUCTOR_PASSWORD=

# Opcional: URL de un servidor ya levantado (si no, se usa npm run dev)
# E2E_BASE_URL=http://localhost:3000
